{
  "paths": {
    "/api/v1/alert-events": {
      "get": {
        "operationId": "listAlertHistoryEvents",
        "tags": [
          "Operations"
        ],
        "summary": "Read retained local alert transitions",
        "description": "Schema 21, Session only. One local SQLite snapshot rechecks the administrator. No remote service, collection, repair, replay or authority restoration. Optional origin/episode filters affect rows only. Descending exclusive sequence pagination; decode query names before duplicate checks, bound encoded query to 1024 bytes. Neither restart nor retention establishes recovery; empty history does not prove health.",
        "security": [
          {
            "Session": []
          }
        ],
        "x-vproxy-max-query-bytes": 1024,
        "x-vproxy-max-response-bytes": 131072,
        "responses": {
          "200": {
            "description": "One retained local snapshot, not current source health.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertHistoryPage"
                }
              }
            }
          },
          "400": {
            "description": "invalid_alert_history: malformed/duplicate/unknown query, identity or decimal. JSON/body/media guards retain their normal errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Session/CSRF/Origin or automation_route_denied; alert_history_denied rechecks the stored administrator. Node mTLS grants no access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "alert_history_not_queryable: exact event/episode not retained, not proof of non-execution.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "management_upgrade_required, alert_history_capacity, policy_busy, policy_unavailable or request_timeout. No implicit migration. A lost reply or 5xx does not prove rollback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Revision"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Canonical decimal 1..50 without leading zero.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          {
            "name": "origin_node_id",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "episode_id",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Revision"
            }
          }
        ]
      }
    },
