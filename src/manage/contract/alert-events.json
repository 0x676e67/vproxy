    "/api/v1/alert-episodes/{id}/acknowledge": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Revision"
          },
          "description": "Positive durable event/episode sequence, not a 22-character resource ID."
        }
      ],
      "post": {
        "operationId": "acknowledgeAlertHistoryEpisode",
        "tags": [
          "Operations"
        ],
        "summary": "Record review of one exact incident transition",
        "description": "Schema 21, Session/CSRF/Origin only; no query. Administrator, expected local node, original episode and latest transition rechecked in one transaction. Does not change health/status/code. Same-state repeat returns original acknowledgement without appending or attributing another actor. Confirmed 409 alert_history_conflict means no write; re-read before a new explicit confirmation. Lost reply or 5xx is unknown: retain original identity and inspect original episode, never automatically re-POST or change expected_transition_sequence.",
        "security": [
          {
            "Session": [],
            "Csrf": []
          }
        ],
        "x-vproxy-max-query-bytes": 0,
        "x-vproxy-max-response-bytes": 32768,
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertHistoryAcknowledgementInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retained episode after review; same-state repetition preserves the original actor/event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertHistoryEpisode"
                }
              }
            }
          },
          "400": {
            "description": "invalid_alert_history: malformed/duplicate/unknown query, identity or decimal. JSON/body/media guards retain their normal errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Session/CSRF/Origin or automation_route_denied; alert_history_denied rechecks the stored administrator. Node mTLS grants no access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "alert_history_not_queryable: exact event/episode not retained, not proof of non-execution.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "alert_history_conflict: expected node/latest transition changed; transaction made no write. Re-read and explicitly confirm the new transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "management_upgrade_required, alert_history_capacity, policy_busy, policy_unavailable or request_timeout. No implicit migration. A lost reply or 5xx does not prove rollback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
