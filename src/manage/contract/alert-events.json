        },
        "retained_episode_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "retained_event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "unacknowledged_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "oldest_sequence": {
          "$ref": "#/components/schemas/NullableRevision"
        },
        "trimmed": {
          "$ref": "#/components/schemas/Counter"
        }
      },
      "description": "Local retained counts, including ended review states. unacknowledged_count<=retained_episode_count. Not current unresolved faults or live source health. Error is unknown, never a healthy zero."
