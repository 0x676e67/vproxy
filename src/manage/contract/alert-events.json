  "schemas": {
    "AlertHistoryEndReason": {
      "enum": [
        "source_unmonitored",
        "monitor_restarted",
        null
      ],
      "description": "Source loss or observer restart, never a successful health result."
    },
    "AlertHistoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "node_id",
        "episode_id",
        "boot_id",
        "incident_id",
        "kind",
        "origin_node_id",
        "resource_id",
        "check",
        "target",
        "code",
        "first_observed_at_unix_ms",
        "last_observed_at_unix_ms",
        "evidence_sequence",
        "transition",
        "observed_at_unix_ms",
        "recorded_at_unix_ms",
        "end_reason",
        "administrator_id",
        "acknowledged_transition_sequence"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/components/schemas/Revision"
        },
        "node_id": {
          "$ref": "#/components/schemas/Id"
        },
        "episode_id": {
          "$ref": "#/components/schemas/Revision"
        },
        "boot_id": {
          "$ref": "#/components/schemas/Id"
        },
        "incident_id": {
          "$ref": "#/components/schemas/AlertEpisodeId"
        },
        "kind": {
          "$ref": "#/components/schemas/AlertKind"
        },
        "origin_node_id": {
          "$ref": "#/components/schemas/Id"
        },
        "resource_id": {
          "$ref": "#/components/schemas/NullableId"
        },
        "check": {
          "enum": [
            "bind",
            "tcp",
            null
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "code": {
          "$ref": "#/components/schemas/AlertCode"
        },
        "first_observed_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "last_observed_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "evidence_sequence": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "transition": {
          "enum": [
            "opened",
            "reason_changed",
            "recovered",
            "unmonitored",
            "acknowledged"
          ]
        },
        "observed_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "recorded_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "end_reason": {
          "$ref": "#/components/schemas/AlertHistoryEndReason"
        },
        "administrator_id": {
          "$ref": "#/components/schemas/NullableId"
        },
        "acknowledged_transition_sequence": {
          "$ref": "#/components/schemas/NullableRevision"
        }
      },
      "description": "Immutable accepted transition, not live health. node_id observes origin_node_id. Event/episode IDs are positive i64 decimals; incident_id preserves the boot-local u64. Nullable wall time is display metadata, never ordering or authority. No raw slot, command, secret or evidence freshness.",
      "allOf": [
        {
          "if": {
            "properties": {
              "transition": {
                "const": "acknowledged"
              }
            }
          },
          "then": {
            "properties": {
              "administrator_id": {
                "$ref": "#/components/schemas/Id"
              },
              "acknowledged_transition_sequence": {
                "$ref": "#/components/schemas/Revision"
              }
            }
          },
          "else": {
            "properties": {
              "administrator_id": {
                "type": "null"
              },
              "acknowledged_transition_sequence": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transition": {
                "const": "unmonitored"
              }
            }
          },
          "then": {
            "properties": {
              "end_reason": {
                "enum": [
                  "source_unmonitored",
                  "monitor_restarted"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "end_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "egress_check"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "$ref": "#/components/schemas/Id"
              },
              "check": {
                "enum": [
                  "bind",
                  "tcp"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "check": {
                      "const": "bind"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "target": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "management_https",
                  "node_tls",
                  "remote_observation"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "type": "null"
              },
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proxy_tls"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "$ref": "#/components/schemas/Id",
                "description": "Stable managed endpoint identity, not an address, peer or list position."
              },
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AlertHistoryEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "boot_id",
        "incident_id",
        "kind",
        "origin_node_id",
        "resource_id",
        "check",
        "target",
        "code",
        "first_observed_at_unix_ms",
        "last_observed_at_unix_ms",
        "evidence_sequence",
        "status",
        "ended_at_unix_ms",
        "end_reason",
        "latest_transition_sequence",
        "acknowledged_transition_sequence",
        "acknowledged_by",
        "acknowledged_at_unix_ms",
        "acknowledgement_event_sequence",
        "is_acknowledged"
      ],
      "properties": {
        "id": {
          "$ref": "#/components/schemas/Revision"
        },
        "node_id": {
          "$ref": "#/components/schemas/Id"
        },
        "boot_id": {
          "$ref": "#/components/schemas/Id"
        },
        "incident_id": {
          "$ref": "#/components/schemas/AlertEpisodeId"
        },
        "kind": {
          "$ref": "#/components/schemas/AlertKind"
        },
        "origin_node_id": {
          "$ref": "#/components/schemas/Id"
        },
        "resource_id": {
          "$ref": "#/components/schemas/NullableId"
        },
        "check": {
          "enum": [
            "bind",
            "tcp",
            null
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "code": {
          "$ref": "#/components/schemas/AlertCode"
        },
        "first_observed_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "last_observed_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "evidence_sequence": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "status": {
          "$ref": "#/components/schemas/AlertStatus"
        },
        "ended_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "end_reason": {
          "$ref": "#/components/schemas/AlertHistoryEndReason"
        },
        "latest_transition_sequence": {
          "$ref": "#/components/schemas/Revision"
        },
        "acknowledged_transition_sequence": {
          "$ref": "#/components/schemas/NullableRevision"
        },
        "acknowledged_by": {
          "$ref": "#/components/schemas/NullableId"
        },
        "acknowledged_at_unix_ms": {
          "$ref": "#/components/schemas/AlertNullableCounter"
        },
        "acknowledgement_event_sequence": {
          "$ref": "#/components/schemas/NullableRevision"
        },
        "is_acknowledged": {
          "type": "boolean"
        }
      },
      "description": "Latest retained projection, not live health. Old acknowledgements remain after a later transition; is_acknowledged requires that confirmation name latest_transition_sequence. Producer/client additionally compare exact numbers. Review never recovers or ends an incident. Restart ends old active episodes as unmonitored/monitor_restarted. Missing/pruned does not prove non-execution.",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unmonitored"
              }
            }
          },
          "then": {
            "properties": {
              "end_reason": {
                "enum": [
                  "source_unmonitored",
                  "monitor_restarted"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "end_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "ended_at_unix_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "acknowledged_transition_sequence": {
                  "type": "null"
                },
                "acknowledged_by": {
                  "type": "null"
                },
                "acknowledged_at_unix_ms": {
                  "type": "null"
                },
                "acknowledgement_event_sequence": {
                  "type": "null"
                },
                "is_acknowledged": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "acknowledged_transition_sequence": {
                  "$ref": "#/components/schemas/Revision"
                },
                "acknowledged_by": {
                  "$ref": "#/components/schemas/Id"
                },
                "acknowledgement_event_sequence": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "egress_check"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "$ref": "#/components/schemas/Id"
              },
              "check": {
                "enum": [
                  "bind",
                  "tcp"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "check": {
                      "const": "bind"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "target": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "management_https",
                  "node_tls",
                  "remote_observation"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "type": "null"
              },
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "proxy_tls"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "$ref": "#/components/schemas/Id",
                "description": "Stable managed endpoint identity, not an address, peer or list position."
              },
              "check": {
                "type": "null"
              },
              "target": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AlertHistoryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "items",
        "next_cursor",
        "oldest_sequence",
        "trimmed"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/components/schemas/Id"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/components/schemas/AlertHistoryEvent"
          }
        },
        "next_cursor": {
          "$ref": "#/components/schemas/NullableRevision"
        },
        "oldest_sequence": {
          "$ref": "#/components/schemas/NullableRevision"
        },
        "trimmed": {
          "$ref": "#/components/schemas/Counter"
        }
      },
      "description": "At most 50 descending immutable event sequences with exclusive before cursor. Retains 16,384 events independently of 12,288 active and 4,096 closed episodes. Schema22 can retain opted-in background observations with their original source node; it does not read remote history. trimmed is a cumulative exact count, not boolean. oldest_sequence describes global retained history, even when a filter returns no rows. This is not a live snapshot cursor."
    },
    "AlertHistorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "retained_episode_count",
        "retained_event_count",
        "unacknowledged_count",
